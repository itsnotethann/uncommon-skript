on load:
	wait 3 ticks
	set {-conc::count} to 0
	loop 50 times:
		fire test event "conc" off the main thread
	loop 100 times:
		wait 1 tick
		if {-conc::count} is 50:
			exit loop
	mark "count %{-conc::count}%"
	mark "all main %whether {-conc::offmain} is not set%"

on test "conc":
	add 1 to {-conc::count}
	if test thread is not "main":
		set {-conc::offmain} to true
