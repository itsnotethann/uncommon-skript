on load:
	set {_a::*} to "x", "y" and "z"
	add "w" to {_a::*}
	mark "add %{_a::4}% %size of {_a::*}%"
	delete {_a::2}
	add "v" to {_a::*}
	mark "hole %{_a::2}% %size of {_a::*}%"
	set {_b::*} to 1, 2, 3, 4 and 5
	delete {_b::5}
	add 9 to {_b::*}
	mark "tail %{_b::5}% %size of {_b::*}%"
	set {_c::*} to "only"
	mark "single %{_c::1}% %size of {_c::*}%"
	add "two" to {_c::*}
	mark "grew %{_c::2}%"
	set {_d::*} to 1, 2 and 3
	set {_d::*} to "a" and "b"
	mark "reset %size of {_d::*}% %{_d::1}% %{_d::2}% %{_d::3}%"
	set {_e::*} to {_a::*}
	mark "copy %size of {_e::*}%"
	loop {_e::*}:
		mark "loop %loop-index% %loop-value%"
	set {_f::x} to 1
	set {_f::*} to 7 and 8
	mark "replaced %size of {_f::*}% %{_f::1}% %{_f::x}%"
	set {_g::*} to "p" and "q"
	delete {_g::*}
	mark "cleared %size of {_g::*}%"
	add "fresh" to {_g::*}
	mark "refill %{_g::1}%"
	set {_h::2} to "two"
	set {_h::1} to "one"
	set {_i::*} to {_h::*}
	mark "keyed %{_i::1}% %{_i::2}% %size of {_i::*}%"
