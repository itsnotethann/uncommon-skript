function benchnoop(n: number) :: number:
	return {_n}

on load:
	delete {bench::*}
	delete {benchlist::*}
	loop 100 times:
		set {benchlist::%loop-number%} to loop-number

on bench "overhead":
	set {_x} to 1

on bench "localset":
	loop 1000 times:
		set {_x} to 1

on bench "localget":
	set {_x} to 1
	loop 1000 times:
		set {_y} to {_x}

on bench "globalset":
	loop 1000 times:
		set {bench::value} to 1

on bench "globalget":
	set {bench::value} to 1
	loop 1000 times:
		set {_y} to {bench::value}

on bench "listindex":
	loop 1000 times:
		set {_list::1} to 1

on bench "arithliteral":
	loop 1000 times:
		set {_x} to 1 + 2 * 3

on bench "arithvar":
	set {_x} to 0
	loop 1000 times:
		set {_x} to {_x} + 1

on bench "stringinterp":
	set {_x} to 7
	loop 1000 times:
		set {_s} to "a%{_x}%b"

on bench "branch":
	set {_x} to 1
	loop 1000 times:
		if {_x} is 1:
			set {_y} to 1

on bench "funccall":
	loop 1000 times:
		set {_x} to benchnoop(1)

on bench "listloop":
	loop {benchlist::*}:
		set {_x} to loop-value

on bench "nested":
	set {_a} to "alpha"
	set {_b} to "beta"
	loop 1000 times:
		set {_n} to length of (join {_a} and {_b} with "-")

on bench "listget":
	set {_list::1} to 1
	loop 1000 times:
		set {_y} to {_list::1}

on bench "listsize":
	set {_list::*} to 1, 2 and 3
	loop 1000 times:
		set {_n} to size of {_list::*}

on bench "listloopvar":
	set {_items::*} to 1, 2 and 3
	loop 100 times:
		loop {_items::*}:
			set {_x} to loop-value-2

on bench "listsizebig":
	loop 100 times:
		set {_big::%loop-number%} to loop-number
	loop 1000 times:
		set {_n} to size of {_big::*}

function benchargs3(a: number, b: number, c: number) :: number:
	return {_a}

function benchlist(ns: numbers) :: number:
	return 1

function benchwork(n: number) :: number:
	return {_n} * 2 + 1

on bench "funccallargs3":
	loop 1000 times:
		set {_x} to benchargs3(1, 2, 3)

on bench "funccalllist":
	loop 1000 times:
		set {_x} to benchlist(1, 2, 3)

on bench "funccalljava":
	loop 1000 times:
		set {_x} to abs(-1)

on bench "funccallwork":
	loop 1000 times:
		set {_x} to benchwork(2)

on bench "funccallvoid":
	loop 1000 times:
		benchnoop(1)

on bench "listcopy":
	loop 20 times:
		set {_src::%loop-number%} to loop-number
	loop 1000 times:
		set {_dst::*} to {_src::*}
